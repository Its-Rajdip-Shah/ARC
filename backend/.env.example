# Copy this file to backend/.env, then generate the two local secret values
# described below. Do NOT leave SECRET_KEY or ARC_FIELD_ENCRYPTION_KEY blank.
# Never commit backend/.env.
#
# macOS/Linux:
#   cp .env.example .env
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Generate ARC_FIELD_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ARC_FIELD_ENCRYPTION_KEY encrypts the stored TOTP secrets and Canvas API
# tokens. Everyone can use their own key locally, but changing it later makes
# existing rows undecryptable, so a shared environment needs a shared key.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Django's password-only /admin/ (no TOTP). Leave false — use the React staff console.
ENABLE_DJANGO_ADMIN=False
# OpenAPI/Swagger. Omit to follow DEBUG (on locally, off when DEBUG=False).
# ENABLE_API_DOCS=True

# Production HTTPS hardening (keep false/0 for local HTTP).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Percent-encode reserved characters in the password, e.g. '!' becomes %21.
# PostgreSQL is required.
#
# macOS/Linux local PostgreSQL where your OS username is also a
# PostgreSQL role:
# DATABASE_URL=postgres:///arc_db
#
# Password-authenticated / Windows / remote-style local setup:
# DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/arc_db
#
# Percent-encode reserved password characters when required.
DATABASE_URL=postgres:///arc_db

ARC_FIELD_ENCRYPTION_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The institution's Canvas host, with no trailing /api/v1.
CANVAS_BASE_URL=https://canvas.sydney.edu.au

# Study-plan model. Leave keys empty locally; the planner still works and
# falls back to a local deadline order. Providers are tried in order:
# primary, then _2, _3, _4, _5. Empty keys are skipped.
#
# 1) Gemini (Google AI Studio / Generative Language OpenAI compat)
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
#
# 2) xAI Grok
LLM_API_BASE_2=https://api.x.ai/v1
LLM_MODEL_2=grok-3-mini
LLM_API_KEY_2=
#
# 3) Groq free tier (not the same as Grok)
LLM_API_BASE_3=https://api.groq.com/openai/v1
LLM_MODEL_3=openai/gpt-oss-20b
LLM_API_KEY_3=
#
# Optional extra OpenAI-compatible hosts:
# LLM_API_BASE_4=https://api.openai.com/v1
# LLM_MODEL_4=gpt-4o-mini
# LLM_API_KEY_4=
