# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
#   cp .env.example .env
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Generate ARC_FIELD_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ARC_FIELD_ENCRYPTION_KEY encrypts the stored TOTP secrets and Canvas API
# tokens. Everyone can use their own key locally, but changing it later makes
# existing rows undecryptable, so a shared environment needs a shared key.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Percent-encode reserved characters in the password, e.g. '!' becomes %21.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/arc_db

ARC_FIELD_ENCRYPTION_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
